# Greenroom environment (copy to .env and fill in what you have)

# Optional: lets the band, venue and crew agents reason with Claude. Without it
# every agent runs its deterministic heuristic (tests and QA always use that path).
# Get a key from https://platform.claude.com (Claude Console, API billing).
ANTHROPIC_API_KEY=

# Which brain the agents use: heuristic | claude  (default: claude when a key is set)
GREENROOM_BRAIN=heuristic

# Model for the Claude brain (cheap and fast is fine; decisions are small)
GREENROOM_MODEL=claude-haiku-5-5

# RPC the agents and scripts talk to. Devnet by default (where the program is deployed);
# the local scripts (npm run demo:fast, npm run test:program) pass their own local validator URL.
GREENROOM_RPC_URL=https://api.devnet.solana.com
# GREENROOM_RPC_URL=http://127.0.0.1:8899

# Fee payer / funder keypair for scripts (defaults to ~/.config/solana/id.json)
# ANCHOR_WALLET=

# Dashboard (packages/web): RPC and program id exposed to the browser
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=4KSaYomRjbnijK1yAELZEGFMPsoPE6u7unY2T6mASUT8
NEXT_PUBLIC_CLUSTER=devnet
# Optional: a form endpoint (e.g. Formspree) for the "demo version" notice's email sign-up; empty shows the notice without the form
NEXT_PUBLIC_SIGNUP_URL=

# Windows only: override the local validator binary used by scripts/*.mjs
# GREENROOM_VALIDATOR=C:\Users\you\.local\share\solana\install\releases\1.18.18\solana-release\bin\solana-test-validator.exe
